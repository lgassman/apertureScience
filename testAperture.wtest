import aperture.*

describe "aperture science" {
  const camara01 = new Camara(dificultad = 200, potenciaExigible = 100)
  const camara02 = new Camara(dificultad = 450, potenciaExigible = 100)
  const camara03 = new Camara(dificultad = 100, potenciaExigible = 15)
  const camara04 = new Camara(dificultad = 300, potenciaExigible = 100)

  const moralidad = new NucleoDeMoralidad()
  const inteligencia = new NucleoDeInteligencia(optimizacion = 0.5, memoria = 40)
  const ira = new NucleoDeInteligenciaEmocional(optimizacion = 0.5, memoria = 40, emocionalidad = -30)
  const glados = new Agente()

  method incorporarNucleosDeGlados() {
    glados.incorporar(moralidad)
    glados.incorporar(inteligencia)
    glados.incorporar(ira)
  }

  test "1.1 y 1.2 consultas de los núcleos" {
    assert.equals(50, moralidad.capacidadDeResolver())
    assert.equals(5, moralidad.potenciaExigida(camara01))

    assert.equals(100, inteligencia.capacidadDeResolver())
    assert.equals(20, inteligencia.potenciaExigida(camara01))

    assert.equals(130, ira.capacidadDeResolver())
    assert.equals(20, ira.potenciaExigida(camara01))
  }

  test "1.3 consultas del agente" {
    self.incorporarNucleosDeGlados()

    assert.equals(280, glados.capacidadDeResolver())
    assert.equals(20, glados.potenciaExigida(camara01))
    assert.that(glados.puedeUtilizar(camara01))
    assert.notThat(glados.puedeUtilizar(camara02))
    assert.notThat(glados.puedeUtilizar(camara03))
  }

  test "2 utilizar cámaras" {
    self.incorporarNucleosDeGlados()

    glados.utilizar(camara01)
    assert.equals(397, glados.capacidadDeResolver())

    assert.throwsException({ glados.utilizar(camara02) })
    assert.throwsException({ glados.utilizar(camara03) })
    assert.equals(397, glados.capacidadDeResolver())

    glados.utilizar(camara04)
    assert.equals(514, glados.capacidadDeResolver())

    glados.utilizar(camara01)
    assert.equals(471, glados.capacidadDeResolver())
    assert.equals(100, glados.potenciaExigida(camara01))

    glados.utilizar(camara01)
    assert.equals(548, glados.capacidadDeResolver())
    assert.equals(40, glados.potenciaExigida(camara01))

    assert.equals([camara01, camara04, camara01, camara01], glados.historialDeUso())
    assert.equals(#{camara01, camara04}, glados.camarasUsadas())
  }

  test "3 consultas de la empresa" {
    const facil = new Camara(dificultad = 90, potenciaExigible = 100)
    const media = new Camara(dificultad = 200, potenciaExigible = 100)
    const imposible = new Camara(dificultad = 500, potenciaExigible = 100)
    const wheatley = new Agente()
    wheatley.incorporar(new NucleoDeInteligencia(optimizacion = 0.8, memoria = 30))
    self.incorporarNucleosDeGlados()
    aperture.incorporar(glados)
    aperture.incorporar(wheatley)

    assert.equals(#{glados}, aperture.agentesQuePuedenUtilizar(media))
    assert.that(aperture.todosPuedenUtilizar(facil))
    assert.notThat(aperture.todosPuedenUtilizar(media))

    glados.utilizar(media)
    glados.utilizar(facil)
    wheatley.utilizar(facil)

    assert.equals(glados, aperture.agenteQueUtilizo(media))
    assert.throwsException({ aperture.agenteQueUtilizo(imposible) })
    assert.equals(#{media, facil}, aperture.camarasUtilizadas())
  }
}
